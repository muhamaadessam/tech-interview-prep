# Browser configuration. The browser talks only to the Node backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=

# Backend-only values. Never expose these with a NEXT_PUBLIC_ prefix.
# Clerk verification and all database access happen in backend/ (Node.js).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_JWKS_URL=
CLERK_JWT_ISSUER=
CLERK_SECRET_KEY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
OPENAI_API_KEY=

# Backend-only hardening; set TRUST_PROXY_HOPS=1 behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
UPSTREAM_TIMEOUT_MS=5000
